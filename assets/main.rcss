body {
	font-family: "Microsoft YaHei";
	font-size: 15px;
	color: #1f2937;
	background-color: #eef1f6;
	margin: 0;
	padding: 0;
}

#app {
	width: 100%;
	height: 100%;
}

#header {
	height: 64px;
	padding-left: 24px;
	background-color: #1f2937;
}

#brand {
	display: inline-block;
	margin-top: 14px;
	font-size: 24px;
	font-weight: bold;
	color: #f9fafb;
}

#subtitle {
	display: inline-block;
	margin-left: 12px;
	font-size: 14px;
	color: #9ca3af;
}

#content {
	padding: 18px 20px 20px 20px;
}

#panel {
	display: inline-block;
	vertical-align: top;
	width: 400px;
	padding: 16px 18px;
	background-color: #ffffff;
	border-radius: 10px;
	border: 1px #d7dce5;
}

#preview-panel {
	display: inline-block;
	vertical-align: top;
	width: 480px;
	margin-left: 16px;
	padding: 16px 18px;
	background-color: #ffffff;
	border-radius: 10px;
	border: 1px #d7dce5;
}

.section {
	margin-top: 6px;
	margin-bottom: 10px;
	font-size: 13px;
	font-weight: bold;
	color: #6b7280;
}

.row {
	height: 38px;
}

.label {
	display: inline-block;
	width: 76px;
	font-size: 14px;
	color: #4b5563;
}

.value {
	display: inline-block;
	font-size: 15px;
	color: #111827;
}

.small {
	font-size: 13px;
	color: #6b7280;
}

input {
	display: inline-block;
	width: 268px;
	height: 28px;
	padding-left: 8px;
	font-size: 14px;
	color: #111827;
	background-color: #f9fafb;
	border: 1px #cbd5e1;
	border-radius: 6px;
}

input:focus {
	border: 1px #2563eb;
}

#actions {
	margin-top: 16px;
}

button {
	height: 34px;
	padding-left: 16px;
	padding-right: 16px;
	margin-right: 10px;
	font-size: 14px;
	border-radius: 7px;
	border: 1px #cbd5e1;
	background-color: #f3f4f6;
	color: #374151;
}

button:hover {
	background-color: #e5e7eb;
}

.primary {
	background-color: #2563eb;
	border: 1px #1d4ed8;
	color: #ffffff;
}

.primary:hover {
	background-color: #1d4ed8;
}

#status {
	margin-top: 14px;
	font-size: 13px;
	color: #6b7280;
}

#preview {
	margin: 0;
	padding: 12px;
	font-size: 12px;
	line-height: 1.55;
	color: #334155;
	background-color: #f8fafc;
	border: 1px #e2e8f0;
	border-radius: 8px;
	white-space: pre-wrap;
}
