<rml>
<head>
	<link type="text/template" href="main.rcss"/>
	<title>Anvil</title>
</head>
<body>
<div id="app">
	<div id="header">
		<span id="brand">Anvil</span>
		<span id="subtitle">授权文件生成器</span>
	</div>

	<div id="content">
		<div id="panel">
			<div class="section">本机信息</div>
			<div class="row"><span class="label">特征码</span><span class="value" id="mc">读取中…</span></div>
			<div class="row"><span class="label">CPU</span><span class="value small" id="cpu">—</span></div>
			<div class="row"><span class="label">网卡</span><span class="value small" id="macs">—</span></div>

			<div class="section">授权参数</div>
			<div class="row"><span class="label">产品号</span><input type="text" id="in-product" value="10652"/></div>
			<div class="row"><span class="label">序列号</span><input type="text" id="in-serial" value=""/></div>
			<div class="row"><span class="label">学生数</span><input type="text" id="in-students" value="1"/></div>
			<div class="row"><span class="label">到期</span><input type="text" id="in-period" value="2099-12-31 23:59:59"/></div>

			<div id="actions">
				<button id="btn-serial" class="ghost">随机序列号</button>
				<button id="btn-generate" class="primary">生成授权文件</button>
			</div>
			<div id="status">就绪</div>
		</div>

		<div id="preview-panel">
			<div class="section">明文预览</div>
			<pre id="preview">点击「生成授权文件」后在这里预览</pre>
		</div>
	</div>
</div>
</body>
</rml>
